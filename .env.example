# The template of .env: the settings of development, and the defaults of the tests, which read .env after .env.test.
# bin/setup copies it to .env, which git ignores; change your copy, not this committed file, and put no secrets here.
# A variable already in the environment, or set in .env.local, wins over .env. Production reads no dotenv file: the
# server's settings are in the deploy user's ~/.env. README's Configuration section has the details.

# The PostgreSQL login of the opencourts databases, shared with otvorenesudy-api (config/database.yml). Left empty,
# PostgreSQL's defaults apply: your own user, on localhost. To share a login with otvorenesudy-api, set the one it uses.
OPENCOURTS_DATABASE_HOST=localhost
OPENCOURTS_DATABASE_USER=
OPENCOURTS_DATABASE_PASSWORD=

# Optional, with the defaults in the code.
# REDIS_URL=redis://localhost:6379/0     # Sidekiq's queues
# ELASTICSEARCH_URL=http://localhost:9200  # the search indices (bin/elasticsearch --daemon runs it)
# RAILS_MAX_THREADS=3                    # Puma's threads
# SIDEKIQ_CONCURRENCY=1                  # Sidekiq's threads
