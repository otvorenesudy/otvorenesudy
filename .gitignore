.bundle
.idea
.project
.sass-cache
.tags

.~lock.*
*.*~

Gemfile.lock.tags

/storage
/tags

/db/*.sqlite3
/log/*
/tmp/*

!/log/.keep
!/tmp/.keep

/config/configuration.yml

# Rails credentials' keys (production's encrypted file is committed). Each developer keeps their own development
# credentials, from config/credentials/development.example.
/config/master.key
/config/credentials/*.key
/config/credentials/development.*
!/config/credentials/development.example

# Generated nightly (config/sitemap.rb)
/public/sitemaps/

# dotenv, in development and the tests: each developer's .env and .env.test, which bin/setup copies from the committed
# .env.example and .env.test.example, and any other dotenv file of their own (.env.local, .env.development.local,
# .env.production). CI's workflow copies the committed .env.ci to .env.test. The committed files hold no secrets.
/.env
/.env.*
!/.env.example
!/.env.*.example
!/.env.ci

plans/*.md

# Claude Code: personal settings and agent worktrees
/.claude/settings.local.json
/.claude/worktrees/
/.claude/plans

# Node tooling (Prettier), Dart Sass builds and coverage reports
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/coverage/
