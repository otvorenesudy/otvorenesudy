# The settings of the tests in CI: .github/workflows/ci.yml copies this file to .env.test before the app boots, in place
# of the .env.test a developer makes from .env.test.example. Committed, so it holds no secrets: the login is that of the
# workflow's own PostgreSQL service container, which exists only while the job runs. Redis and Elasticsearch are its
# service containers too, on localhost at the ports the code defaults to.
OPENCOURTS_DATABASE_HOST=localhost
OPENCOURTS_DATABASE_USER=opencourts
OPENCOURTS_DATABASE_PASSWORD=opencourts # betterleaks:allow -- the CI service container's, not a secret

# Eager-loads the app in the tests, as production does (config/environments/test.rb). GitHub Actions sets it as well.
CI=true

# A failed browser spec saves the page's HTML beside its screenshot in tmp/capybara.
RAILS_SYSTEM_TESTING_SCREENSHOT_HTML=1
