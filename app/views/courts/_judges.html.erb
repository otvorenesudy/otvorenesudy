<% { chairman: @court.chairs, vice_chairman: @court.vicechairs, judicial_council_chairman: @court.judicial_council_chairs, judicial_council_member: @court.judicial_council_members }.each do |position, judges| %>
  <% if judges.any? %>
    <h2 class="h4 text-uppercase mt-4">
      <%= t ".#{position.to_s.pluralize(judges.size)}" %>
    </h2>

    <p><%= links_to_judges judges %></p>
  <% end %>
<% end %>

<h2 class="h4 text-uppercase mt-4">
  <%= t '.judges' %>
</h2>

<% if (listed = @judges.active.listed).any? %>
  <p><%= t '.explanation.listed' %></p>

  <%= render 'courts/judges/list', court: @court, judges: listed %>
<% end %>

<% if (others = @judges.inactive_or_unlisted).any? %>
  <p class="mt-4"><%= t '.explanation.other' %></p>

  <%= render 'courts/judges/list', court: @court, judges: others %>
<% end %>
