<% provide :title, t('.title') %>

<h1 class="mb-4"><%= t '.title' %></h1>

<% if @uoo_stats && @uoo_stats[:total_count].positive? %>
  <p class="lead mb-4">
    <%= t '.subtitle', count: @uoo_stats[:total_count], fine: "#{number_with_delimiter(@uoo_stats[:total_fine], delimiter: ' ')} #{@uoo_stats[:currency]}" %>
  </p>

  <% if @uoo_stats[:by_party].any? %>
    <div class="table-responsive-sm mb-5">
      <table class="table">
        <thead>
          <tr>
            <th scope="col"><%= t '.stats.party' %></th>
            <th class="text-end" scope="col"><%= t '.stats.count' %></th>
            <th class="text-end" scope="col"><%= t '.stats.fine' %></th>
          </tr>
        </thead>
        <tbody>
          <% @uoo_stats[:by_party].each do |row| %>
            <tr>
              <td><%= link_to_uoo_party row[:name] %></td>
              <td class="text-end"><%= row[:count] %></td>
              <td class="text-end">
                <% if row[:fine].positive? %>
                  <%= number_with_delimiter(row[:fine], delimiter: ' ') %> <%= row[:currency] || @uoo_stats[:currency] %>
                <% else %>
                  &mdash;
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="text-muted small text-end"><%= t '.disclaimer' %></p>
    </div>
  <% end %>
<% end %>

<ul class="search-result-list">
  <% @uoo_decrees.each do |decree| %>
    <li class="search-result-item">
      <%= render 'decrees/uoo/decree', decree: %>

      <% if decree['children'].any? %>
        <ul class="search-result-list ps-4 border-start ms-2 mt-2">
          <% decree['children'].each do |child| %>
            <li class="search-result-item border-0 pe-0">
              <%= render 'decrees/uoo/decree', decree: child %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </li>
  <% end %>
</ul>

<% if @uoo_source_url.present? %>
  <p class="text-muted small mt-3 text-end">
    <%= t '.source' %>: <%= link_to @uoo_source_url, @uoo_source_url, target: '_blank', rel: 'noopener noreferrer' %>
  </p>
<% end %>
