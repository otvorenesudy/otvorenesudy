<% provide :title, t('.title') %>

<div class="row">
  <div class="col">
    <h1 class="mb-4"><%= t('.title') %></h1>

    <% if @uoo_stats && @uoo_stats[:total_count] > 0 %>
      <p class="lead mb-4">
        <%= t('.subtitle',
              count: @uoo_stats[:total_count],
              fine: "#{number_with_delimiter(@uoo_stats[:total_fine], delimiter: ' ')} #{@uoo_stats[:currency]}") %>
      </p>

      <% if @uoo_stats[:by_party].any? %>
        <div class="table-responsive-sm mb-5">
          <table class="table">
            <thead>
              <tr>
                <th scope="col"><%= t('.stats.party') %></th>
                <th class="text-right" scope="col"><%= t('.stats.count') %></th>
                <th class="text-right" scope="col"><%= t('.stats.fine') %></th>
              </tr>
            </thead>
            <tbody>
              <% @uoo_stats[:by_party].each do |row| %>
                <tr>
                  <td>
                    <%= link_to row[:name], decrees_path(q: row[:name]),
                          data: { toggle: 'tooltip', placement: 'bottom' },
                          title: t('.search_party_tooltip') %>
                  </td>
                  <td class="text-right"><%= row[:count] %></td>
                  <td class="text-right">
                    <% if row[:fine] > 0 %>
                      <%= number_with_delimiter(row[:fine], delimiter: ' ') %> <%= row[:currency] || @uoo_stats[:currency] %>
                    <% else %>
                      &mdash;
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <p class="text-muted small text-right"><%= t('.disclaimer') %></p>
        </div>
      <% end %>
    <% end %>

    <ul class="search-result-list">
      <% @uoo_decrees.each do |decree| %>
        <% fine = Array.wrap(decree['parties']).map { |p| p['fine_amount'] }.compact.first %>
        <% fine_currency = Array.wrap(decree['parties']).map { |p| p['fine_currency'] }.compact.first || 'EUR' %>
        <li class="search-result-item">
          <h4 class="search-result-title d-flex justify-content-between align-items-baseline">
            <span>
              <% if decree['title'].present? %>
                <%= link_to decree['title'], decree['url'], target: '_blank', rel: 'noopener noreferrer' %>
              <% else %>
                <%= link_to t('.decree'), decree['url'], target: '_blank', rel: 'noopener noreferrer' %>
              <% end %>
              <% if decree['parsed_date'] %>
                <small><%= t('.issued_on', date: l(decree['parsed_date'], format: :uoo)) %></small>
              <% elsif decree['date'].present? %>
                <small><%= t('.issued_on', date: decree['date']) %></small>
              <% end %>
            </span>
            <% if fine %>
              <span class="font-weight-bold text-nowrap ml-3">
                <%= number_with_delimiter(fine, delimiter: ' ') %> <%= fine_currency %>
              </span>
            <% end %>
          </h4>

          <div class="search-result-content">
            <ul class="float-sm-right list-unstyled text-sm-right ml-sm-2 mb-2">
              <% Array.wrap(decree['case_file_number']).each do |number| %>
                <li><%= tooltip_tag number, t('.case_file_number'), class: 'text-muted', placement: 'left' %></li>
              <% end %>
              <% if decree['file_identification_number'].present? %>
                <li><%= tooltip_tag decree['file_identification_number'], t('.file_identification_number'), class: 'text-muted', placement: 'left' %></li>
              <% end %>
            </ul>

            <% Array.wrap(decree['parties']).each do |party| %>
              <% if party['name'].present? %>
                <strong><%= link_to party['name'], decrees_path(q: party['name']),
                       data: { toggle: 'tooltip', placement: 'bottom' },
                       title: t('.search_party_tooltip') %></strong><br>
              <% end %>
              <% if party['address'].present? %>
                <%= party['address'] %><br>
              <% end %>
            <% end %>
          </div>

          <% if decree['children'].any? %>
            <ul class="search-result-list pl-4 border-left ml-2 mt-2">
              <% decree['children'].each do |child| %>
                <% child_fine = Array.wrap(child['parties']).map { |p| p['fine_amount'] }.compact.first %>
                <% child_fine_currency = Array.wrap(child['parties']).map { |p| p['fine_currency'] }.compact.first || 'EUR' %>
                <li class="search-result-item border-0 pr-0">
                  <h4 class="search-result-title d-flex justify-content-between align-items-baseline">
                    <span>
                      <% if child['title'].present? %>
                        <%= link_to child['title'], child['url'], target: '_blank', rel: 'noopener noreferrer' %>
                      <% else %>
                        <%= link_to t('.decree'), child['url'], target: '_blank', rel: 'noopener noreferrer' %>
                      <% end %>
                      <% if child['effect_on_chain_root_decree'] %>
                        <span class="badge badge-<%= uoo_decree_effect_badge_class(child['effect_on_chain_root_decree']) %> ml-1"><%= t(".effect.#{child['effect_on_chain_root_decree']}") %></span>
                      <% end %>
                      <% if child['parsed_date'] %>
                        <small><%= t('.issued_on', date: l(child['parsed_date'], format: :uoo)) %></small>
                      <% elsif child['date'].present? %>
                        <small><%= t('.issued_on', date: child['date']) %></small>
                      <% end %>
                    </span>
                  </h4>

                  <div class="search-result-content">
                    <ul class="float-sm-right list-unstyled text-sm-right ml-sm-2 mb-2">
                      <% Array.wrap(child['case_file_number']).each do |number| %>
                        <li><%= tooltip_tag number, t('.case_file_number'), class: 'text-muted', placement: 'left' %></li>
                      <% end %>
                      <% if child['file_identification_number'].present? %>
                        <li><%= tooltip_tag child['file_identification_number'], t('.file_identification_number'), class: 'text-muted', placement: 'left' %></li>
                      <% end %>
                    </ul>

                    <% Array.wrap(child['parties']).each do |party| %>
                      <% if party['name'].present? %>
                        <strong><%= link_to party['name'], decrees_path(q: party['name']),
                               data: { toggle: 'tooltip', placement: 'bottom' },
                               title: t('.search_party_tooltip') %></strong><br>
                      <% end %>
                      <% if party['address'].present? %>
                        <%= party['address'] %><br>
                      <% end %>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ul>

    <% if @uoo_source_url.present? %>
      <p class="text-muted small mt-3 text-right">
        <%= t('.source') %>: <%= link_to @uoo_source_url, @uoo_source_url, target: '_blank', rel: 'noopener noreferrer' %>
      </p>
    <% end %>
  </div>
</div>
