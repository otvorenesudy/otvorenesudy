<% @facets.each do |facet| %>
  <% next if facet.abstract? || !facet.visible? || !@collapsible_facets.include?(facet.name) %>

  <% own = facet.view[:facet] || "#{controller_name}/facets/#{facet.name}_facet" %>
  <%= render lookup_context.exists?(own, [], true) ? own : "facets/#{facet.type}_facet", facet:, translation: t(facet.key) %>
<% end %>
