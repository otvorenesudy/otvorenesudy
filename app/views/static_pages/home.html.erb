<%
  slides = [
    ['slides/vytrvame-darujte-pastircak-2024.png', 'V snahe o lepšie Slovensko vytrváme', 'https://transparency.darujme.sk/vytrvame/?referral_tag_id=0c53dd1c-dacb-422c-93a8-8f3b0808fac0'],
    ['slides/2-percenta-2023.png', '2% pre Transparency International', 'https://transparency.sk/sk/2percenta'],
    ['slides/prokuratura.svg', 'Otvorená Prokuratúra', 'https://prokuratura.otvorenesudy.sk'],
    ['slides/rytieri.png', 'Rytieri a bojovníčky Transparency', 'https://transparency.sk/sk/rytieri'],
    ['slides/vazby-zacali-klesat.png', 'Počet rodín medzi sudcami začal konečne klesať', 'https://transparency.sk/sk/pocet-rodin-medzi-sudcami-zacal-konecne-klesat/'],
    ['slides/justicia-a-infozakon.svg', 'Justícia a infozákon', 'https://transparency.sk/sk/akademia/temy/justicia'],
    ['slides/korupcia-zabija-spravodlivost.svg', 'Korupcia zabíja spravodlivosť', 'https://transparency.darujme.sk/2319/?donation=40&periodicity=periodical'],
    ['slides/spravy-z-boja-proti-korupcii.svg', 'Správy z boja proti korupcii', 'https://eepurl.com/doWD8X']
  ]
%>

<div class="row">
  <div class="col">
    <div id="carousel" class="carousel carousel-fade slide mb-5" data-bs-ride="carousel">
      <div class="carousel-inner mb-3">
        <% slides.each_with_index do |(image, text, url), index| %>
          <div class="carousel-item<%= ' active' if index.zero? %>">
            <%= link_to image_tag(image, alt: text, class: 'd-block w-100'), url, class: 'd-block w-100' %>
          </div>
        <% end %>
      </div>
      <div class="carousel-indicators">
        <% slides.each_with_index do |(_, text, _), index| %>
          <%= button_tag '', type: 'button', class: ('active' if index.zero?), data: { bs_target: '#carousel', bs_slide_to: index }, 'aria-current': (true if index.zero?), 'aria-label': text %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<div class="row">
  <div class="col-12 col-lg-7 col-xl-6">
    <div class="feature h-100 p-4">
      <h1 class="text-info mb-4">
        <%= t('.feature.headline') %><br><%= t('.feature.footline') %>
      </h1>
      <h4 class="mb-3">
        <%= t('.feature.list', project: tag.span(t('.feature.project'), class: 'text-uppercase')) %>
      </h4>
      <div class="d-flex align-items-center">
        <ol class="list-unstyled mb-0">
          <% t('.feature.items').each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ol>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-5 col-xl-6 mt-4 mt-lg-0">
    <div class="row fw-bold text-center text-uppercase">
      <%= link_to icon_tag('courts', size: 60) + tag.span(t('.squares.courts')), courts_path, class: 'square mx-3 mb-4' %>
      <%= link_to icon_tag('judges', size: 60) + tag.span(t('.squares.judges')), judges_path, class: 'square mx-3 mb-4' %>
      <div class="d-block d-md-none d-lg-block d-xl-none w-100"></div>
      <%= link_to icon_tag('hearings', size: 60) + tag.span(t('.squares.hearings')), hearings_path, class: 'square mx-3 mb-4' %>
      <div class="d-none d-md-block d-lg-none d-xl-block w-100"></div>
      <%= link_to icon_tag('decrees', size: 60) + tag.span(t('.squares.decrees')), decrees_path, class: 'square mx-3 mb-4 mb-xl-0' %>
      <div class="d-block d-md-none d-lg-block d-xl-none w-100"></div>
      <%= link_to icon_tag('whistleblower', size: 60) + tag.span(t('.squares.uoo')), uoo_decrees_path, class: 'square mx-3 mb-4 mb-lg-0' %>
      <%= link_to icon_tag('judges', size: 60) + tag.span(t('.squares.prokuratura')), 'https://prokuratura.otvorenesudy.sk', class: 'square mx-3 mb-4' %>
    </div>
  </div>
</div>
<div class="row">
  <div class="col">
    <div class="partners mt-lg-4 px-sm-4">
      <h4 class="mb-4"><%= t('.partners.supported_by') %></h4>
      <div class="d-flex flex-column flex-sm-row">
        <%= link_to brand_tag('websupport', width: 150, height: 50), 'https://websupport.sk', class: 'websupport mt-1 ms-2 ms-sm-0 me-sm-4 mb-3 mb-sm-0', 'aria-label': 'WebSupport' %>
        <%= link_to brand_tag('index-podnikatela', width: 245.05, height: 50), 'https://indexpodnikatela.sk', class: 'ip ms-2 ms-sm-0', 'aria-label': 'Index podnikateľa' %>
      </div>
    </div>
  </div>
</div>
