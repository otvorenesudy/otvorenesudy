<h2 class="h4 text-uppercase my-4">
  <%= t '.headline' %>
</h2>

<% if (indicators = judge.indicators_2015) %>
  <% if indicators.statistical %>
    <%= render 'judges/indicators_2015/basic', judge:, indicators: indicators.statistical %>
    <%= render 'judges/indicators_2015/evaluation', judge:, indicators: indicators.statistical %>
  <% end %>

  <% if indicators.numerical %>
    <%= render 'judges/indicators/comparison', judge:, facets:, others:, year: 2015, dataset: Judge::Indicators2015 %>
  <% end %>

  <% if indicators.statistical %>
    <%= render 'judges/indicators_2015/quality', judge:, indicators: indicators.statistical %>
    <%= render 'judges/indicators_2015/efficiency', judge:, indicators: indicators.statistical %>
  <% end %>
<% else %>
  <p class="mb-0">
    <%= t '.none' %>
  </p>
<% end %>
