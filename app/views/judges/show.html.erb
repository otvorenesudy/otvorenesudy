<% provide :title, @judge.name %>

<h1 class="text-uppercase my-4">
  <%= yield :title %>
  <%= judge_activity_icon_tag @judge, @judge.active, size: 20, placement: 'right' %>
</h1>

<ol class="list-unstyled">
  <% @employments.each do |employment| %>
    <li>
      <%= judge_activity_by_employment(employment).upcase_first %>
      <%= judge_position_by_employment(employment) %>
      <%= t '.at_court' %> <%= link_to_court employment.court %>,
      <% hearings = Hearing.during_employment(employment).exact.size %>
      <%= t '.register', count: hearings %>
      <%= translate_with_count(hearings, :hearing) %>
      <%= two_words_connector %>&nbsp;<%= translate_with_count(Decree.during_employment(employment).exact.size, :decree) %>.
      <% if employment.note %>
        <br>
        <%= t '.note' %>: <%= employment.note.sub(/\.?\z/, '.') %>
      <% end %>
    </li>
  <% end %>
</ol>

<%= render 'designations' if @designations.any? %>
<%= render 'relatives' if @judge.related_people_by_year.any? %>
<%= render 'notes' if @judge.substantiation_notes_by_year.any? %>

<% active = @latest_indicators&.to_s&.dasherize || 'decrees' %>

<ul class="nav nav-tabs mt-4" role="tablist" data-controller="tabs">
  <%= tab_link_tag t('.indicators', year: 2021), 'indicators-2021', class: ('active' if active == 'indicators-2021') %>
  <% [2017, 2015, 2013].each do |year| %>
    <%= tab_link_tag year, "indicators-#{year}", class: ('active' if active == "indicators-#{year}") %>
  <% end %>
  <%= tab_link_tag t('.decrees'), 'decrees', class: ('active' if active == 'decrees') %>
  <%= tab_link_tag t('.upcoming_hearings'), 'upcoming-hearings' %>
  <%= tab_link_tag t('.historical_hearings'), 'historical-hearings' %>
</ul>

<div class="tab-content">
  <%= tab_content_tag 'indicators-2021', class: (%w[active show] if active == 'indicators-2021') do %>
    <%= render 'indicators_2021', judge: @judge %>
  <% end %>
  <% @comparisons.each do |key, comparison| %>
    <% tab = key.to_s.dasherize %>
    <%= tab_content_tag tab, class: (%w[active show] if active == tab) do %>
      <%= render key.to_s, judge: @judge, facets: comparison.facets, others: comparison.others %>
    <% end %>
  <% end %>
  <%= tab_content_tag 'decrees', class: (%w[active show] if active == 'decrees') do %>
    <%= render 'decrees', decrees: @decrees.limit(10), query: { judges: [@judge.name] } %>
  <% end %>
  <%= tab_content_tag 'upcoming-hearings' do %>
    <%= render 'hearings', prefix: 'upcoming', hearings: @upcoming_hearings.limit(10), query: { judges: [@judge.name] } %>
  <% end %>
  <%= tab_content_tag 'historical-hearings' do %>
    <%= render 'hearings', prefix: 'historical', hearings: @historical_hearings.limit(10), query: { judges: [@judge.name], historical: true } %>
  <% end %>
</div>

<% source = @judge.listed ? 'listed' : 'unlisted' %>
<p class="small text-muted mt-4 mb-0">
  <%= s t(".resource_note.#{source}.description", document: link_to_source(t(".resource_note.#{source}.document"), @judge.uri), update: time_tag(@judge.updated_at.to_date, format: :default)) %>
  <%= s t('.resource_note.supplement') %>
</p>
