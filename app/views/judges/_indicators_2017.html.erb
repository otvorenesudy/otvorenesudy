<h2 class="h4 text-uppercase my-4">
  <%= t '.headline' %>
</h2>

<% if (indicators = judge.indicators_2017) %>
  <% if indicators.statistical %>
    <%= render 'judges/indicators_2017/basic', judge:, indicators: indicators.statistical %>
    <%= render 'judges/indicators_2017/evaluation', judge:, indicators: indicators.statistical %>
  <% end %>

  <% if indicators.numerical %>
    <%= render 'judges/indicators/comparison', judge:, facets:, others:, year: 2017, dataset: Judge::Indicators2017 %>
  <% end %>

  <% if indicators.statistical %>
    <%= render 'judges/indicators_2017/quality', judge:, indicators: indicators.statistical %>
    <%= render 'judges/indicators_2017/efficiency', judge:, indicators: indicators.statistical %>
  <% end %>
<% else %>
  <p class="mb-0">
    <%= t '.none' %>
  </p>
<% end %>
