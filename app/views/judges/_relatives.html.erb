<p>
  <%= t '.close_ones' %>
  <%= to_sentence(@judge.related_people_by_year.map { |year, _| link_to_collapse year, "#relatives-#{year}", data: { bs_parent: '#relatives' } }) %>.
</p>
<div id="relatives">
  <% @judge.related_people_by_year.each do |year, people| %>
    <div id="relatives-<%= year %>" class="collapse ms-3" data-bs-parent="#relatives">
      <p class="ms-3 mb-0">
        <%= t '.close_ones_for' %> <%= year %>:
      </p>
      <ul class="list-unstyled ms-3">
        <% people.each do |person| %>
          <li>
            <%= person.function.upcase_first if person.function %>
            <%= link_to_related_person person %><% if person.institution %>, <%= link_to_institution person.institution %><% end %>.
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
