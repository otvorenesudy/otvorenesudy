  <% end %>
</ul>

<p>
  <%= assigned_agendas_indicator_2013 indicators %>.
  <%= decided_agendas_indicator_2013 indicators %>.
</p>

<p>
  <%= t '.judge_results', days: indicators['S6'], cases: indicators['S7'] %>
