</p>

<p>
  <%= t '.performance_data', years: indicators['S3'] %>
</p>

<ul class="list-unstyled ms-3">
  <% if indicators['S3_2013'] %>
    <li>2013 &ndash; <%= links_to_courts indicators['S3_2013'].compact %></li>
  <% end %>

  <% if indicators['S3_2012'] %>
    <li>2012 &ndash; <%= links_to_courts indicators['S3_2012'].compact %></li>
  <% end %>

  <% if indicators['S3_2011'] %>
