<div class="facet" data-controller="facet-suggest" data-facet-suggest-url-value="<%= suggest_path(facet.params.merge(facet: facet.name, id: @judge.id)) %>">
  <h6 class="facet-title">
    <%= t 'judges.indicators.numerical.additional_judges' %>
  </h6>

  <div class="facet-content">
    <div class="small text-muted mb-3">
      <%= t 'judges.indicators.numerical.judges_note.content' %>
    </div>

    <%= facet_suggest_input_tag facet, placeholder: translation[:placeholder] %>

    <div class="facet-results" data-facet-suggest-target="results" aria-live="polite">
      <%= render 'judges/indicators/facets/name_results', facet:, visible: facet.results.first(10), other: facet.results[10..] || [] %>
    </div>
  </div>
</div>
