<h2 class="h4 text-uppercase my-4">
  <%= t '.headline' %>
</h2>

<% if (indicators = judge.indicators_2013) %>
  <% if I18n.locale == :en %>
    <div class="alert alert-warning" role="alert">
      <%= t '.untranslated' %>
    </div>
  <% end %>

  <% if indicators.statistical %>
    <%= render 'judges/indicators_2013/basic', judge:, indicators: indicators.statistical %>
  <% end %>

  <% if indicators.numerical && indicators.numerical.to_hash.values[2..9].compact.size == 8 %>
    <%= render 'judges/indicators/comparison', judge:, facets:, others:, year: 2013, dataset: Judge::Indicators2013 %>
  <% end %>

  <% if indicators.statistical %>
    <%= render 'judges/indicators_2013/statistical', judge:, indicators: indicators.statistical %>
    <%= render 'judges/indicators_2013/notes', judge:, indicators: indicators.statistical %>
  <% end %>
<% else %>
  <p class="mb-0">
    <%= t '.none' %>
  </p>
<% end %>
