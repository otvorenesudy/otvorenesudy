<% if page.current? %>
  <li class="page-item active" aria-current="page">
    <span class="page-link">
      <%= number_with_delimiter(page) %>
      <%= span_tag t('kaminari.pagination.current'), class: 'visually-hidden' %>
    </span>
  </li>
<% else %>
  <li class="page-item">
    <%= link_to number_with_delimiter(page), url, class: 'page-link' %>
  </li>
<% end %>
