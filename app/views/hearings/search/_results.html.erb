<%= search_list_tag results, offset: offset do |hearing| %>
  <li class="search-result-item">
    <h4 class="search-result-title">
      <%= link_to hearing_headline(hearing, limit: 57), hearing %>
      <small>
        <%= t 'hearings.search.results.hearing' %> <%= t hearing.historical ? 'hearings.search.results.past' : 'hearings.search.results.future' %>
        <%= hearing.date ? hearing_date(hearing.date) : t('hearings.search.results.unknown') %>
      </small>
    </h4>

    <div class="search-result-content">
      <% if hearing.unprocessed? %>
        <div class="alert alert-danger alert-sm mb-2">
          <%= s t('hearings.search.results.unprocessed') %>
        </div>
      <% elsif hearing.future_date? %>
        <div class="alert alert-warning alert-sm mb-2">
          <%= s t('hearings.search.results.future_date') %>
        </div>
      <% end %>

      <ul class="float-sm-end list-unstyled text-sm-end ms-sm-2 mb-2">
        <li><%= tooltip_tag hearing.case_number || '?', t('case_number.full'), class: 'text-muted', placement: 'left' %></li>
        <li><%= tooltip_tag hearing.file_number || '?', t('file_number.full'), class: 'text-muted', placement: 'left' %></li>
        <% if current_user&.admin? && !hearing.anonymized? %>
          <li class="mt-3"><%= button_to t('hearings.show.anonymize'), anonymize_hearing_path(hearing), method: :delete, class: 'btn btn-link text-danger p-0' %></li>
        <% end %>
      </ul>

      <% if hearing.court %>
        <%= t 'hearings.search.results.court' %> &ndash; <%= link_to_court hearing.court %>
        <br>
      <% end %>
      <% if hearing.judges.any? %>
        <% if hearing.exact_judges.any? %>
          <%= translate_without_count(hearing.exact_judges.size, :judge).upcase_first %>
          &ndash; <%= links_to_judges hearing.exact_judges %>
        <% else %>
          <%= translate_without_count(hearing.inexact_judgings.map(&:judge_name_unprocessed).uniq.size, :judge).upcase_first %>
          &ndash; <%= judge_processed_names hearing.inexact_judgings %>
        <% end %>
        <br>
      <% end %>
      <% { proposers: :proposer, opponents: :opponent, defendants: :defendant }.each do |party, key| %>
        <% people = hearing.public_send(party) %>
        <% if people.any? %>
          <%= translate_without_count(people.size, key).upcase_first %> &ndash; <%= people.map(&:name).to_sentence %>
          <br>
        <% end %>
      <% end %>
    </div>
  </li>
<% end %>
