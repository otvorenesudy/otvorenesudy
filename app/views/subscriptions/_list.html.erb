<ol class="list-unstyled">
  <% subscriptions.each do |subscription| %>
    <% id = dom_id(subscription) %>
    <li class="mb-4">
      <h2 class="h4 text-uppercase">
        <%= t '.title' %> <%= t subscription.query.model.underscore.to_sym, count: :other %>
      </h2>
      <% if subscription.query.value.any? %>
        <ul class="list-unstyled mb-2">
          <% subscription_query(subscription).each do |facet, values| %>
            <li><%= facet %> &ndash; <%= values %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="mb-2"><%= t '.no_restrictions' %></p>
      <% end %>
      <p class="small text-muted mb-2">
        <%= t '.registered_at' %> <%= time_tag subscription.created_at, format: :default %>
      </p>
      <%= form_with model: subscription, id: "edit_#{id}", class: 'd-flex flex-wrap align-items-center gap-2 mb-2' do %>
        <div class="btn-group btn-group-sm" role="group" aria-label="<%= t 'search.subscribe.period' %>">
          <% Period.values.each_key do |name| %>
            <% period = Period.public_send(name) %>
            <%= radio_button_tag :period_id, period.id, subscription.period == period, id: "#{id}_period_#{name}", class: 'btn-check', autocomplete: 'off' %>
            <%= label_tag "#{id}_period_#{name}", t("period.#{name}"), class: 'btn btn-outline-secondary' %>
          <% end %>
        </div>
        <%= link_to_search subscription.query.model, t('.search'), params: subscription.query.value, class: 'btn btn-sm btn-outline-primary' %>
        <button type="submit" class="btn btn-sm btn-outline-primary"><%= t '.update' %></button>
        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete_<%= id %>"><%= t '.delete' %></button>
      <% end %>
      <div id="delete_<%= id %>" class="modal" tabindex="-1" aria-labelledby="delete_<%= id %>_title" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h1 id="delete_<%= id %>_title" class="modal-title text-uppercase"><%= t '.are_you_sure' %></h1>
            </div>
            <div class="modal-footer">
              <%= button_to t('.confirm_delete'), subscription, method: :delete, class: 'btn btn-outline-danger', form_class: 'd-inline' %>
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t '.cancel' %></button>
            </div>
          </div>
        </div>
      </div>
    </li>
  <% end %>
</ol>
