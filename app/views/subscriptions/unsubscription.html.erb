<% provide :title, t('subscriptions.unsubscribe.title') %>

<h1 class="text-uppercase my-4"><%= yield :title %></h1>

<% if @subscription %>
  <p><%= t 'subscriptions.unsubscribe.question' %></p>

  <% if @subscription.query.value.any? %>
    <ul class="list-unstyled">
      <% subscription_query(@subscription).each do |facet, values| %>
        <li><%= facet %> &ndash; <%= values %></li>
      <% end %>
    </ul>
  <% end %>

  <%# The answer is a page, as to the mail client's one-click POST, not a redirect, which Turbo would need. %>
  <%= button_to t('subscriptions.unsubscribe.confirm'), unsubscribe_subscriptions_path, params: { token: @subscription.token }, class: 'btn btn-outline-danger', form: { data: { turbo: false } } %>
<% else %>
  <p><%= t 'subscriptions.unsubscribe.unknown' %></p>
<% end %>
