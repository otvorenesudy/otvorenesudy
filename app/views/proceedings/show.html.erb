<% provide :title, proceeding_title(@proceeding) %>

<h1 class="text-uppercase my-4">
  <%= proceeding_headline @proceeding, limit: 49, tooltip: true %>
  <% if @proceeding.legislation_areas_and_subareas.any? %>
    <span class="d-inline d-xl-none">,</span><br class="d-none d-xl-inline">
    <%= proceeding_subject @proceeding, limit: 49, tooltip: true %>
  <% end %>
  <small class="d-block h6 fw-bold mt-2 mb-0">
    <%= render 'proceedings/duration', proceeding: @proceeding %>
  </small>
</h1>

<div class="row">
  <div class="col-xl-8 mb-0-last">
    <p>
      <%= t '.for_proceeding' %> <%= t '.so_far' unless @proceeding.probably_closed? %><%= t '.register' %>
      <%= translate_with_count @hearings.size, :hearing %> <%= two_words_connector %> <%= translate_with_count @decrees.size, :decree %>.
    </p>
    <% if @courts.any? %>
      <p><%= translate_without_count(@courts.size, :court).upcase_first %> &ndash; <%= links_to_courts @courts %></p>
    <% end %>
    <% if @judges.any? %>
      <p>
        <% if (exact = @proceeding.judges_exact.order(:last, :middle, :first)).any? %>
          <%= translate_without_count(exact.size, :judge).upcase_first %> &ndash; <%= links_to_judges exact %>
        <% else %>
          <% inexact = @proceeding.judges_inexact.order(:last, :middle, :first) %>
          <%= translate_without_count(inexact.size, :judge).upcase_first %> &ndash; <%= judge_processed_names @proceeding.inexact_judgings, @proceeding.inexact_judgements %>
        <% end %>
      </p>
    <% end %>
  </div>

  <div class="col-xl-4">
    <ul class="list-unstyled bg-light border mt-3 mt-xl-0 mb-0 p-3">
      <% @proceeding.case_numbers.each do |case_number| %>
        <li class="d-flex justify-content-between mx-2">
          <span class="me-2"><%= tooltip_tag t('case_number.acronym'), t('case_number.full'), placement: 'left' %>:</span>
          <%= link_to_proceedings_search case_number, class: 'text-truncate', params: { case_numbers: [case_number] } %>
        </li>
      <% end %>
      <li class="d-flex justify-content-between mx-2">
        <span class="me-2"><%= tooltip_tag t('file_number.acronym'), t('file_number.full'), placement: 'left' %>:</span>
        <%= @proceeding.file_number ? link_to_proceedings_search(@proceeding.file_number, class: 'text-truncate', params: { file_number: [@proceeding.file_number] }) : t('file_number.missing') %>
      </li>
      <% @proceeding.eclis.each do |ecli| %>
        <li class="d-flex justify-content-between mx-2">
          <span class="me-2"><%= tooltip_tag t('ecli.acronym'), t('ecli.full'), placement: 'left' %>:</span>
          <%= link_to_proceedings_search ecli, class: 'text-truncate', params: { q: ecli } %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<nav class="border-top mt-4">
  <p class="h3 fw-bold text-center text-uppercase mt-4 mb-3"><%= t '.timeline.present' %></p>
  <ol class="timeline mb-0 py-3">
    <% ([nil] + @events.reverse).each_cons(2) do |previous, event| %>
      <% kind = event.class.name.downcase %>
      <%= render "proceedings/timeline/#{kind}", kind.to_sym => event, previous: %>
    <% end %>
    <li class="timeline-item timeline-distance-unknown d-flex flex-column-reverse p-3">
      <span class="h5 fw-bold mb-0"><%= t '.timeline.pleading' %></span>
      <small class="h6 fw-bold mb-2"><%= t '.timeline.unknown_date' %></small>
    </li>
  </ol>
  <p class="h3 fw-bold text-center text-uppercase mt-3 mb-4"><%= t '.timeline.past' %></p>
</nav>

<p class="small text-muted mt-4 mb-0">
  <%= t '.resource_note.description', ministry: link_to(t('.resource_note.ministry'), ProceedingsHelper::MINISTRY_URL) %>
</p>
