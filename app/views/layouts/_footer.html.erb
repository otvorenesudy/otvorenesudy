<footer class="container small mt-5 px-sm-0 py-3">
  <div class="d-flex align-items-start align-items-xl-center text-uppercase border-bottom mb-3">
    <nav class="nav nav-primary flex-row flex-grow-1 mb-3">
      <div class="d-flex flex-column flex-xl-row flex-grow-1 flex-xl-grow-0 me-4 me-xl-0">
        <%= link_to t('.about'), static_page_path('about'), class: 'nav-link ms-0 me-auto me-xl-3' %>
        <%= link_to t('.analyses'), 'https://transparency.sk/sk/tag/sudy', class: 'nav-link ms-0 ms-xl-3 me-auto me-xl-3' %>
        <%= link_to t('.faq'), static_page_path('faq'), class: 'nav-link ms-0 ms-xl-3 me-auto me-xl-3' %>
        <%= link_to t('.feedback'), static_page_path('feedback'), class: 'nav-link ms-0 ms-xl-3 me-auto me-xl-3' %>
      </div>
      <div class="d-flex flex-column flex-xl-row flex-grow-1 flex-xl-grow-0 me-4">
        <%= link_to t('.tos'), static_page_path('tos'), class: 'nav-link ms-0 ms-xl-3 me-auto me-xl-3' %>
        <%= link_to t('.privacy'), static_page_path('privacy'), class: 'nav-link ms-0 ms-xl-3 me-auto me-xl-3' %>
        <%= link_to t('.api'), static_page_path('api'), class: 'nav-link ms-0 ms-xl-3 me-auto me-xl-3' %>
        <%= link_to t('.contact'), static_page_path('contact'), class: 'nav-link ms-0 ms-xl-3 me-0' %>
      </div>
    </nav>

    <nav class="nav nav-primary flex-column flex-md-row flex-nowrap align-items-center justify-content-center mb-3">
      <%= link_to t('.sign_in'), new_user_session_path, class: 'nav-link fw-bold mx-auto me-md-4 mt-3 mt-md-0 mb-0' unless user_signed_in? %>
      <%= link_to t('.donate'), donation_url, class: 'btn btn-primary order-first order-md-last', role: :button %>
    </nav>
  </div>

  <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <nav class="nav justify-content-start col me-3 mb-3 p-0">
      <%= link_to brand_tag('transparency-international-slovensko', width: 158.33, height: 38, variant: I18n.locale), 'https://transparency.sk', class: 'tis', 'aria-label': 'Transparency International Slovensko' %>
    </nav>

    <div class="flex-grow-1 flex-grow-lg-0 text-center order-last order-lg-0 border-top border-top-lg-0 mb-3">
      <nav class="nav nav-secondary justify-content-center mt-3 mt-lg-0 mb-2 mb-md-0">
        <%= link_to 'Transparency International Slovensko', 'https://transparency.sk', class: 'nav-link fw-bold mb-2 mb-sm-0' %>
        <%= link_to "© 2013-#{Date.current.year}", static_page_path('copyright'), class: 'nav-link' %>
        <%= link_to Rails.configuration.x.github.organization, organization_url, class: 'nav-link' %>
        <%= link_to OpenCourts::VERSION::STRING, repository_url("releases/tag/v#{OpenCourts::VERSION::STRING}"), class: 'nav-link' %>
      </nav>
      <%= t '.disclaimer.resources' %>
      <br class="d-inline d-md-none">
      <%= t '.disclaimer.correctness' %>
    </div>

    <nav class="nav flex-nowrap justify-content-end col ms-3 mb-3 p-0">
      <%= link_to icon_tag('facebook', size: 24), 'https://facebook.com/transparencysk', class: 'nav-link tis m-0', 'aria-label': 'Facebook' %>
      <%= link_to icon_tag('twitter', size: 24), 'https://twitter.com/transparencysk', class: 'nav-link tis mx-1 m-0', 'aria-label': 'Twitter' %>
      <%= link_to icon_tag('youtube', size: 24), 'https://www.youtube.com/user/TISlovensko', class: 'nav-link tis m-0', 'aria-label': 'YouTube' %>
    </nav>
  </div>
</footer>
