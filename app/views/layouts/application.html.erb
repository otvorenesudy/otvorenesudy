<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= resolve_title(yield :title) %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : t('.description') %>">
    <meta name="keywords" content="<%= content_for?(:keywords) ? yield(:keywords) : t('.keywords') %>">
    <meta name="author" content="<%= t '.authors' %>">
    <meta property="og:title" content="<%= resolve_title(yield :title) %>">
    <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : t('.content') %>">
    <meta property="og:image" content="<%= image_url "brands/otvorene-sudy.#{I18n.locale}.svg" %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= resolve_title(yield :title) %>">
    <meta name="twitter:description" content="<%= content_for?(:description) ? yield(:description) : t('.content') %>">
    <meta name="twitter:image" content="<%= image_url "brands/otvorene-sudy.#{I18n.locale}.svg" %>">
    <meta name="twitter:url" content="<%= canonical_url %>">
    <link rel="mask-icon" href="<%= asset_path 'maskicon.svg' %>" sizes="any">
    <link rel="apple-touch-icon" href="<%= asset_path 'touchicon.png' %>">
    <link rel="icon" href="<%= asset_path 'favicon.png' %>">
    <meta name="msapplication-TileImage" content="<%= asset_path 'tileicon.png' %>">
    <meta name="msapplication-TileColor" content="#fff">
    <link rel="prefetch" href="<%= asset_path 'icons.svg' %>">
    <link rel="prefetch" href="<%= asset_path 'brands.svg' %>">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Ubuntu:300,700&subset=latin-ext">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>

    <%# Google Analytics runs once the visitor accepts analytics cookies (cookie_consent.js). %>
    <script type="text/plain" data-category="analytics" data-service="Google Analytics" async src="https://www.googletagmanager.com/gtag/js?id=G-B9KE4RBRL3"></script>
    <script type="text/plain" data-category="analytics" data-service="Google Analytics">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-B9KE4RBRL3');
    </script>
  </head>
  <body>
    <%= render 'layouts/header' %>
    <main class="container mt-4 px-sm-0">
      <%= render 'shared/flash_messages' %>
      <%= yield %>
    </main>
    <%= render 'layouts/footer' %>
  </body>
</html>
