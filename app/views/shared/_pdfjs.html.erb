<% content_for :head do %>
  <%= stylesheet_link_tag 'pdfjs/pdf_viewer' %>
<% end %>

<%= tag.div class: 'pdf-viewer mb-4', data: { controller: 'pdf-viewer', pdf_viewer_url_value: url, pdf_viewer_worker_value: asset_path('pdfjs-dist--build--pdf.worker.js'), pdf_viewer_highlights_value: highlights.to_s.split.to_json } do %>
  <div class="row g-0 mb-2" data-pdf-viewer-target="toolbar">
    <div class="col-lg-3 px-0 mb-2 mb-lg-0">
      <div class="btn-group btn-group-sm border" role="group">
        <span class="btn d-flex align-items-center shadow-none border-0 border-end pe-none">
          <%= t '.page' %>&nbsp;<span data-pdf-viewer-target="pageNumber" aria-live="polite">- / -</span>
        </span>
        <button type="button" class="btn btn-secondary d-flex align-items-center shadow-none border-0 border-start border-end" data-pdf-viewer-target="previousPage" data-action="pdf-viewer#previousPage" aria-label="<%= t '.previous_page' %>" disabled>
          <%= icon_tag 'arrow-up', size: 12 %>
        </button>
        <button type="button" class="btn btn-secondary d-flex align-items-center shadow-none border-0 border-start" data-pdf-viewer-target="nextPage" data-action="pdf-viewer#nextPage" aria-label="<%= t '.next_page' %>" disabled>
          <%= icon_tag 'arrow-down', size: 12 %>
        </button>
      </div>
    </div>
    <div class="col-lg-6 offset-lg-3 px-0">
      <div class="d-flex">
        <div class="input-group input-group-sm">
          <%= search_field_tag 'document_query', nil, id: nil, class: 'form-control form-control-sm p-2 search-query-input search-query-input-sm', placeholder: t('.search'), autocomplete: 'off', 'aria-label': t('.search'), data: { pdf_viewer_target: 'query', action: 'input->pdf-viewer#search keydown->pdf-viewer#navigate' } %>
          <button type="button" class="btn search-query-submit" data-pdf-viewer-target="clear" data-action="pdf-viewer#clear" aria-label="<%= t '.clear' %>" hidden>
            <%= icon_tag 'times', size: 10 %>
          </button>
        </div>

        <div class="btn-group btn-group-sm border flex-shrink-0 ms-2" role="group" data-pdf-viewer-target="matches" hidden>
          <span class="btn d-flex align-items-center text-nowrap shadow-none border-0 border-end pe-none" data-pdf-viewer-target="matchCount" aria-live="polite"></span>
          <button type="button" class="btn btn-secondary d-flex align-items-center shadow-none border-0 border-start border-end" data-action="pdf-viewer#previousMatch" aria-label="<%= t '.previous_match' %>">
            <%= icon_tag 'arrow-up', size: 12 %>
          </button>
          <button type="button" class="btn btn-secondary d-flex align-items-center shadow-none border-0 border-start" data-action="pdf-viewer#nextMatch" aria-label="<%= t '.next_match' %>">
            <%= icon_tag 'arrow-down', size: 12 %>
          </button>
        </div>
      </div>

      <div class="form-text text-muted text-end" data-pdf-viewer-target="help" hidden><%= t '.match_help' %></div>
    </div>
  </div>

  <div class="pdf-viewer-frame" data-pdf-viewer-target="frame">
    <div class="pdf-viewer-loading row" data-pdf-viewer-target="loading" aria-hidden="true">
      <div class="col-lg-6 offset-lg-3 mt-5">
        <% [5, 4, 6, 3, 5, 4].each do |width| %>
          <div class="row mb-2"><div class="bg-loading pdf-viewer-line col-<%= width %>"></div></div>
        <% end %>
        <div class="row my-5"><div class="bg-loading pdf-viewer-title col-10 offset-1"></div></div>
        <% 8.times do %>
          <div class="row mb-2"><div class="bg-loading pdf-viewer-line col-12"></div></div>
        <% end %>
      </div>
    </div>

    <div class="pdf-viewer-container" data-pdf-viewer-target="container">
      <div class="pdfViewer" data-pdf-viewer-target="viewer"></div>
    </div>
  </div>

  <p class="text-center mt-5" data-pdf-viewer-target="error" hidden><%= t '.error' %></p>
<% end %>
