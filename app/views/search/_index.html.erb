<%# From lg up the facets sit left, controls and results right; below lg: controls, facets, results. %>
<div id="search-<%= @model.model_name.plural.dasherize %>" class="row">
  <div class="col-lg-9 order-lg-2 mb-3 mb-lg-4">
    <%= render 'search/controls' %>
  </div>
  <div class="col-lg-3 order-lg-1 mb-5 mb-lg-0 pe-lg-4">
    <%= render 'search/subscribe' if @model.respond_to?(:subscribe) %>
    <%= render 'facets/list' %>
  </div>
  <div class="col-lg-9 offset-lg-3 order-lg-3">
    <%= render 'search/results' %>
  </div>
</div>
