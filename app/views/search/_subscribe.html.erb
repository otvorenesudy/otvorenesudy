<% new_subscription = !user_signed_in? || @subscription.new_record? %>
<% modal = new_subscription ? 'create_subscription' : 'update_subscription' %>

<button type="button" class="btn btn-outline-primary w-100 mb-3" data-bs-toggle="modal" data-bs-target="#<%= modal %>">
  <%= t '.subscribe' %>
</button>

<div id="<%= modal %>" class="modal" tabindex="-1" aria-labelledby="<%= modal %>_title" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h1 id="<%= modal %>_title" class="modal-title text-uppercase"><%= t '.subscribe' %></h1>
      </div>
      <div class="modal-body">
        <% if user_signed_in? %>
          <p class="text-<%= new_subscription ? 'primary' : 'info' %>">
            <%= t new_subscription ? '.introduction' : '.already_subscribed' %>
          </p>
          <p>
            <%= t '.explanation' %>
          </p>
          <%= form_with model: @subscription, id: new_subscription ? 'new_subscription' : "edit_subscription_#{@subscription.id}" do |form| %>
            <%= form.fields_for :query do |query| %>
              <%= query.hidden_field :model, value: @model.to_s %>
              <%= query.hidden_field :value, value: Query.unwrap(@facets.query_params) %>
            <% end %>
            <div class="btn-group btn-group-sm" role="group" aria-label="<%= t '.period' %>">
              <% Period.values.each_key do |name| %>
                <% period = Period.public_send(name) %>
                <%= radio_button_tag :period_id, period.id, @subscription.period == period, id: "period_#{name}", class: 'btn-check', autocomplete: 'off' %>
                <%= label_tag "period_#{name}", t("period.#{name}"), class: 'btn btn-outline-secondary' %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <%= t '.sign_in_required' %>
        <% end %>
      </div>
      <div class="modal-footer">
        <% if user_signed_in? %>
          <% if new_subscription %>
            <button type="submit" class="btn btn-outline-primary" form="new_subscription"><%= t '.create' %></button>
          <% else %>
            <button type="submit" class="btn btn-outline-primary" form="edit_subscription_<%= @subscription.id %>"><%= t '.update' %></button>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete_subscription"><%= t '.delete' %></button>
          <% end %>
        <% else %>
          <%= link_to t('.sign_up'), new_registration_path(:user), class: 'btn btn-outline-primary', role: :button %>
          <%= link_to t('.sign_in'), new_session_path(:user), class: 'btn btn-outline-primary', role: :button %>
        <% end %>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t '.cancel' %></button>
      </div>
    </div>
  </div>
</div>

<% unless new_subscription %>
  <div id="delete_subscription" class="modal" tabindex="-1" aria-labelledby="delete_subscription_title" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 id="delete_subscription_title" class="modal-title text-uppercase"><%= t '.are_you_sure' %></h1>
        </div>
        <div class="modal-footer">
          <%= button_to t('.confirm_delete'), @subscription, method: :delete, class: 'btn btn-outline-danger', form_class: 'd-inline' %>
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t '.cancel' %></button>
        </div>
      </div>
    </div>
  </div>
<% end %>
