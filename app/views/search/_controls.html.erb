<% sort = (@facets.params[:sort].presence || @sort_fields.first).to_sym %>
<% query_facet = @facets[:q] %>

<div class="d-flex flex-wrap align-items-center justify-content-between">
  <h1 class="display-2 text-truncate text-uppercase me-sm-4 mb-3"><%= yield :title %></h1>
  <div class="btn-toolbar" role="toolbar">
    <% if @facets.query_params.any? %>
      <div class="btn-group btn-group-sm border me-2 mb-3" role="group">
        <%= link_to t('.reset'), search_path, class: 'btn btn-secondary btn-sm shadow-none border-0' %>
      </div>
    <% end %>
    <div class="btn-group btn-group-sm border mb-3" role="group">
      <div class="btn-group btn-group-sm" role="group">
        <button type="button" class="btn btn-secondary dropdown-toggle shadow-none border-0 border-end" data-bs-toggle="dropdown" aria-expanded="false">
          <%= t(".sort.#{@type}.#{sort.to_s.delete_prefix('_')}") %>
        </button>
        <div class="dropdown-menu dropdown-menu-sm">
          <% (@sort_fields - [sort]).each do |value| %>
            <%= link_to t(".sort.#{@type}.#{value.to_s.delete_prefix('_')}"), search_path(@facets.params.merge(sort: value)), class: 'dropdown-item' %>
          <% end %>
        </div>
      </div>
      <%= link_to icon_tag('arrow-up', size: 12), search_path(@facets.params.merge(order: :asc)), class: "btn btn-secondary#{' active' if @facets.params[:order] == :asc} d-flex align-items-center shadow-none border-0 border-start border-end", 'aria-label': t('.ascending') %>
      <%= link_to icon_tag('arrow-down', size: 12), search_path(@facets.params.merge(order: :desc)), class: "btn btn-secondary#{' active' if @facets.params[:order] == :desc} d-flex align-items-center shadow-none border-0 border-start", 'aria-label': t('.descending') %>
    </div>
  </div>
</div>

<%= form_with url: search_path, method: :get, class: 'search-query-form', data: { turbo_action: 'advance' } do %>
  <div class="input-group">
    <%= search_field_tag query_facet.name, params[query_facet.name], class: 'form-control search-query-input', placeholder: t(query_facet.key)[:placeholder], 'aria-label': t(query_facet.key)[:title] %>
    <%= link_to icon_tag('times'), search_path(@facets.params.except(query_facet.name)), class: 'btn search-query-reset', 'aria-label': t('.reset') if query_facet.active? %>
    <button type="submit" class="btn search-query-submit" aria-label="<%= t(query_facet.key)[:title] %>"><%= icon_tag('search') %></button>
  </div>
  <% search_form_params @facets.params.except(query_facet.name) do |name, value| %>
    <%= hidden_field_tag name, value, id: nil %>
  <% end %>
  <%# A GET form drops the query of its action, so the locale goes along as a field. %>
  <%= hidden_field_tag :l, I18n.locale, id: nil %>
<% end %>
