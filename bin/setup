#!/usr/bin/env ruby
# frozen_string_literal: true

# Sets up or updates the development environment; safe to run again at any time. `bin/setup --reset` also reloads the
# database, `--skip-server` doesn't start bin/dev at the end.
require 'fileutils'

APP_ROOT = File.expand_path('..', __dir__)

def system!(*)
  system(*, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts '== Installing dependencies =='
  system! 'git submodule update --init'
  system('bundle check') || system!('bundle install')
  system! 'npm install --no-audit --no-fund'

  puts "\n== Preparing database =="
  system! 'bin/rails db:prepare'
  system! 'bin/rails db:reset' if ARGV.include?('--reset')

  puts "\n== Removing old logs and tempfiles =="
  system! 'bin/rails log:clear tmp:clear'

  puts "\n== Search =="
  puts 'Start Elasticsearch with bin/elasticsearch --daemon, then build the indices with bin/rails probe:reindex.'

  unless ARGV.include?('--skip-server')
    puts "\n== Starting development server =="
    $stdout.flush
    exec 'bin/dev'
  end
end
