#!/usr/bin/env bash
# Checks formatting and lint and exits non-zero on any problem. bin/test runs it first, and the PostToolUse hook in
# .claude/settings.json runs `bin/lint --fix <file>` after every edit an agent makes.
#
#   *.rb, *.rake, Gemfile, ...   RuboCop (.rubocop.yml): formatting, style and lint, with the Rails, RSpec,
#                                FactoryBot, Capybara and Performance cops
#   *.js, *.scss                 Prettier (.prettierrc.json), from package.json's dev dependencies
#
# Without files it checks what this branch changed against origin/main: its commits, staged and unstaged edits, and
# untracked files. `bin/lint --all` checks every file.
#
# Usage:
#   bin/lint [--all | file ...]          check the files (default: the branch's changes)
#   bin/lint --fix [--all | file ...]    format and autocorrect them, then report what is left
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

usage() {
  sed -n '/^# Usage:/,/^[^#]/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//' >&2
  exit 2
}

# RuboCop otherwise looks for the Ruby version in parent directories as it loads each plugin's configuration, and the
# Claude Code sandbox can't read them.
RUBOCOP_TARGET_RUBY_VERSION=$(cut -d. -f1,2 .ruby-version)
export RUBOCOP_TARGET_RUBY_VERSION

ruby_pattern='\.(rb|rake|ru|gemspec)$|(^|/)(Gemfile|Rakefile|Capfile)$'
prettier_pattern='^app/(javascript|assets/stylesheets)/.*\.(js|scss)$'
skip_pattern='^(bin|data|log|node_modules|public|storage|tmp|vendor)/'

# The files this branch changed against the merge base with origin/main (or main), and untracked files.
changed_files() {
  local base="" ref
  for ref in origin/main main; do
    base=$(git merge-base HEAD "$ref" 2>/dev/null) && break
  done
  git diff --name-only --diff-filter=d "${base:-HEAD}" 2>/dev/null
  git ls-files --others --exclude-standard 2>/dev/null
}

fix=0
if [[ "${1:-}" == --fix ]]; then
  fix=1
  shift
fi

case "${1:-}" in
  --all)
    (($# == 1)) || usage
    candidates=$(git ls-files)
    ;;
  -*) usage ;;
  "") candidates=$(changed_files | sort -u) ;;
  *) candidates=$(printf '%s\n' "$@") ;;
esac

ruby=()
prettier=()
while IFS= read -r file; do
  [[ -n "$file" && -f "$file" ]] || continue
  relative=${file#"$PWD"/}
  [[ "$relative" =~ $skip_pattern ]] && continue
  if [[ "$relative" =~ $ruby_pattern ]]; then
    ruby+=("$file")
  elif [[ "$relative" =~ $prettier_pattern ]]; then
    prettier+=("$file")
  fi
done <<<"$candidates"

status=0

if ((${#ruby[@]} > 0)); then
  if ((fix)); then
    bundle exec rubocop --autocorrect --force-exclusion --format quiet "${ruby[@]}" >/dev/null 2>&1
  fi
  bundle exec rubocop --force-exclusion --format emacs "${ruby[@]}" || status=1
fi

if ((${#prettier[@]} > 0)) && [[ -f package.json ]]; then
  if [[ ! -x node_modules/.bin/prettier ]]; then
    echo "Prettier isn't installed. Run: npm install" >&2
    exit 1
  fi
  if ((fix)); then
    node_modules/.bin/prettier --log-level warn --write "${prettier[@]}" || status=1
  else
    node_modules/.bin/prettier --log-level warn --check "${prettier[@]}" || status=1
  fi
fi

exit "$status"
