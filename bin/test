#!/usr/bin/env bash
# Decides whether a change is done: bin/lint on the branch's changes, then the RSpec suite against a test database
# rebuilt from db/structure.sql. Exits non-zero when either fails.
#
# Usage:
#   bin/test               lint, then every spec
#   bin/test <spec> ...    lint, then those specs (spec/models/judge_spec.rb, spec/models/judge_spec.rb:12)
#
# Needs PostgreSQL with pg_trgm, unaccent and pgvector on localhost (brew services start postgresql@17). The app reads
# its local configuration while it boots (.env, .env.local, config/configuration.yml), which the Claude Code sandbox
# hides, so Claude Code runs bin/test outside the sandbox (sandbox.excludedCommands in .claude/settings.json).
#
# One run at a time on this machine: this app and otvorenesudy-api share the opencourts_test database, so a second
# run of either waits for the first.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

lock=/tmp/otvorenesudy-bin-test.lock
waited=0
until mkdir "$lock" 2>/dev/null; do
  if [[ ! -d "$lock" ]]; then
    echo "bin/test: can't create $lock. Run bin/test outside the Claude Code sandbox." >&2
    exit 1
  fi
  pid=$(cat "$lock/pid" 2>/dev/null) || pid=""
  if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
    rm -rf "$lock"
    continue
  fi
  ((waited++)) || echo "bin/test: waiting for the test run already going on this machine (pid ${pid:-?})" >&2
  sleep 2
done
echo $$ >"$lock/pid"
trap 'rm -rf "$lock"' EXIT

status=0

echo "==> lint"
bin/lint || status=1

echo "==> test database"
if ! pg_isready -q -h localhost; then
  echo "PostgreSQL isn't running on localhost. Start it (brew services start postgresql@17), then run bin/test again." >&2
  exit 1
fi
export RAILS_ENV=test
# libpq's GSSAPI negotiation crashes forked Ruby processes on macOS; nothing here uses Kerberos.
export PGGSSENCMODE=disable
if ! output=$(bundle exec rake db:create db:test:purge db:structure:load 2>&1); then
  printf '%s\n' "$output" >&2
  echo "Couldn't prepare the test database." >&2
  exit 1
fi
# Then the migrations db/structure.sql doesn't have yet. Migrating dumps the structure again; DB_STRUCTURE
# (lib/tasks/db.rake) sends that dump to a temporary file, so db/structure.sql stays as it is.
dump=$(mktemp "${TMPDIR:-/tmp}/structure.XXXXXX")
if ! output=$(DB_STRUCTURE=$dump bundle exec rake db:migrate 2>&1); then
  printf '%s\n' "$output" >&2
  echo "Couldn't migrate the test database." >&2
  rm -f "$dump"
  exit 1
fi
rm -f "$dump"
pending=$(sed -nE 's/^== +([0-9]* *[A-Za-z0-9_:]+): migrated.*/\1/p' <<<"$output")
if [[ -n "$pending" ]]; then
  echo "warning: db/structure.sql is missing these migrations, which bin/test applied to the test database:" >&2
  sed 's/^/  /' <<<"$pending" >&2
  echo "  Migrate the development database, then dump it: bundle exec rake db:migrate db:structure:dump" >&2
fi

echo "==> search index"
if ! curl -fs -o /dev/null -m 5 http://localhost:9200; then
  echo "warning: Elasticsearch isn't running on localhost:9200. The specs that index or search (spec/lib/probe," \
    "spec/integration, spec/models/subscription_spec.rb) fail until it runs: Elasticsearch 1.7 with inline Groovy" \
    "scripting (README.md)." >&2
fi

echo "==> specs"
bundle exec rspec --format progress "$@" || status=1

exit "$status"
