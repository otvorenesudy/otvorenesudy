#!/usr/bin/env bash
# Decides whether a change is done: bin/lint on the branch's changes, bin/vendor --check on the vendored browser
# libraries (they must be what package.json's versions make), then the RSpec suite against a test database
# loaded from db/structure.sql and the local Elasticsearch. A full run (no arguments) also measures coverage: SimpleCov
# fails it below 95% of lines or 90% of branches, and undercover fails it for any method this branch changed that no
# spec runs. Exits non-zero when any of them fails.
#
# Usage:
#   bin/test               lint, then every spec, with coverage
#   bin/test <spec> ...    lint, then those specs (spec/system/courts_spec.rb, spec/system/courts_spec.rb:12)
#
# Needs PostgreSQL with pg_trgm, unaccent and pgvector on localhost (brew services start postgresql@17) and
# Elasticsearch 9 on localhost:9200 (bin/elasticsearch --daemon). The app reads its local configuration while it boots
# (.env), which the Claude Code sandbox hides, so Claude Code runs bin/test outside the sandbox
# (sandbox.excludedCommands in .claude/settings.json).
#
# One run at a time on this machine: this app and otvorenesudy-api share the opencourts_test database, so a second
# run of either waits for the first.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

lock=/tmp/otvorenesudy-bin-test.lock
waited=0
until mkdir "$lock" 2>/dev/null; do
  if [[ ! -d "$lock" ]]; then
    echo "bin/test: can't create $lock. Run bin/test outside the Claude Code sandbox." >&2
    exit 1
  fi
  pid=$(cat "$lock/pid" 2>/dev/null) || pid=""
  if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
    rm -rf "$lock"
    continue
  fi
  ((waited++)) || echo "bin/test: waiting for the test run already going on this machine (pid ${pid:-?})" >&2
  sleep 2
done
echo $$ >"$lock/pid"
trap 'rm -rf "$lock"' EXIT

status=0

echo "==> lint"
bin/lint || status=1

echo "==> vendored libraries"
bin/vendor --check || status=1

echo "==> test database"
if ! pg_isready -q -h localhost; then
  echo "PostgreSQL isn't running on localhost. Start it (brew services start postgresql@17), then run bin/test again." >&2
  exit 1
fi
export RAILS_ENV=test
if ! output=$(bin/rails db:create db:test:prepare 2>&1); then
  printf '%s\n' "$output" >&2
  echo "Couldn't prepare the test database." >&2
  exit 1
fi

echo "==> stylesheets"
if ! output=$(bin/rails dartsass:build 2>&1); then
  printf '%s\n' "$output" >&2
  echo "Couldn't build the stylesheets." >&2
  exit 1
fi

echo "==> search"
version=$(curl -fs -m 5 http://localhost:9200 | sed -nE 's/.*"number" *: *"([0-9]+)\..*/\1/p')
if [[ -z "$version" ]]; then
  echo "Elasticsearch isn't running on localhost:9200. Start it with bin/elasticsearch --daemon." >&2
  exit 1
elif ((version < 9)); then
  echo "Elasticsearch on localhost:9200 is version $version; the app needs 9. Run bin/elasticsearch." >&2
  exit 1
fi

echo "==> specs"
if (($# == 0)); then
  export COVERAGE=1
  bundle exec rspec --format progress || status=1

  echo "==> undercover"
  bundle exec undercover --compare origin/main || status=1
else
  bundle exec rspec --format progress "$@" || status=1
fi

exit "$status"
