#!/usr/bin/env bash
# Keeps secrets out of git. Betterleaks, pinned below with its default rules, looks for them in what files say; the
# patterns below catch the files that hold them by name. The git hooks in .githooks run this before every commit and
# push, a Claude Code hook before every file an agent writes, and CI (.github/workflows/security.yml) on every pull
# request and push to main. Betterleaks only matches patterns: it never sends what it finds anywhere.
#
# A finding that isn't a secret (a test password, a placeholder) gets `betterleaks:allow` in a comment on its line, or,
# where a comment can't go (a recorded HTTP response), its fingerprint in .betterleaksignore with the reason. That
# file also lists what the history held before this check existed.
#
# Usage:
#   bin/leaks                  the files at HEAD and every commit reachable from it (what CI runs)
#   bin/leaks --staged         the staged changes (the pre-commit hook)
#   bin/leaks --push REMOTE    the commits being pushed, as the pre-push hook reads them from stdin
#   bin/leaks --stdin FILE     the text about to be written to FILE, from stdin (the Claude Code hook)
#   bin/leaks --install        point git at the hooks in .githooks and download Betterleaks
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

usage() {
  sed -n '/^# Usage:/,/^[^#]/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//' >&2
  exit 2
}

version=1.9.0

# Files that hold secrets and never belong in git: an extended regular expression on the path from the repository
# root, then what such a file holds. .gitignore keeps most of them out already.
forbidden='
(^|/)\.env(\.[^/]+)?$                                   a dotenv file: the database login and settings
(^|/)[^/]+\.key$                                        a key, such as the ones that decrypt Rails credentials
(^|/)config/credentials(/[^/]+)?\.ya?ml$                Rails credentials, decrypted (the encrypted .yml.enc are fine)
(^|/)config/(configuration|secrets)\.yml$               the Rails 3.2 app'"'"'s secrets, or Rails 4 and 5 secrets
(^|/)config/initializers/secret_token\.rb$              the Rails 3.2 session secret
(^|/)(id_(rsa|dsa|ecdsa|ed25519)|[^/]+_(rsa|ed25519))$  a private SSH key
\.(pem|p12|pfx|jks|keystore|ppk)$                       a private key or a certificate
(^|/)\.(netrc|npmrc|pgpass|git-credentials)$            logins
(^|/)\.vault_pass[^/]*$|\.pgpassword$                   a password
(^|/)db-backup-[^/]*$|\.(dump|pgdump|sql\.(gz|bz2|xz|zst))$  a database dump, with users'"'"' e-mail addresses and passwords
'

# Files that match a pattern above but are fine to commit, with the reason.
allowed='
(^|/)\.env\.(example|sample)$                           a template without values
'

# The pinned Betterleaks, downloaded on first use into the repository's git directory, which its worktrees share.
betterleaks() {
  local platform checksum dir staging archive
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) platform=darwin_arm64 checksum=83dd7eaab13d44a1e8e347a17064cdef153a1478db473276d41b38d55613d3f2 ;;
    Darwin-x86_64) platform=darwin_x64 checksum=68dfd83458d9e7f90663daa7a81c7f944083b170dae82e4f5f8d0581ed519ef1 ;;
    Linux-aarch64 | Linux-arm64) platform=linux_arm64 checksum=1d39116e0a58dc94574715e2aa12a2dbd5062f193eee3fec011fef6ba06bd13b ;;
    Linux-x86_64) platform=linux_x64 checksum=f8b185a39ffcece2a1ca82bf3a4e7435cd81963ffd16b7a9128daf75f35f6de7 ;;
    *)
      echo "bin/leaks: Betterleaks has no build for $(uname -sm)" >&2
      return 1
      ;;
  esac

  dir="$(git rev-parse --path-format=absolute --git-common-dir)/betterleaks/$version"
  if [[ ! -x "$dir/betterleaks" ]]; then
    mkdir -p "$dir" && staging=$(mktemp -d "$dir/download.XXXXXX") || return 1
    archive="$staging/betterleaks.tar.gz"
    if ! curl -fsSL --retry 3 -o "$archive" \
      "https://github.com/betterleaks/betterleaks/releases/download/v$version/betterleaks_${version}_$platform.tar.gz"; then
      echo "bin/leaks: couldn't download Betterleaks $version from GitHub" >&2
      rm -rf "$staging"
      return 1
    fi
    if [[ "$(sha256 "$archive")" != "$checksum" ]]; then
      echo "bin/leaks: the Betterleaks $version download doesn't match its checksum" >&2
      rm -rf "$staging"
      return 1
    fi
    tar -xzf "$archive" -C "$staging" betterleaks && mv -f "$staging/betterleaks" "$dir/betterleaks"
    rm -rf "$staging"
  fi

  "$dir/betterleaks" "$@"
}

sha256() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$1"
  else
    shasum -a 256 "$1"
  fi | cut -d' ' -f1
}

# Fails when a path on stdin matches a forbidden pattern and no allowed one, naming each such path.
check_names() {
  local path pattern description found=0
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    while read -r pattern description; do
      [[ -n "$pattern" && "$path" =~ $pattern ]] && continue 2
    done <<<"$allowed"
    while read -r pattern description; do
      [[ -n "$pattern" && "$path" =~ $pattern ]] || continue
      ((found)) || echo "bin/leaks: these files hold secrets and don't belong in git:" >&2
      echo "  $path: $description" >&2
      found=1
      break
    done <<<"$forbidden"
  done
  if ((found)); then
    echo "Remove them from the commit and keep them out with .gitignore. One that is safe to commit goes into" \
      "\`allowed\` in bin/leaks, with the reason." >&2
    return 1
  fi
}

# Fails when Betterleaks finds a secret in what the arguments select, printing each finding with its value redacted.
check_contents() {
  betterleaks "$@" --gitleaks-ignore-path .betterleaksignore --redact --no-banner --verbose --legacy-print \
    --log-level warn && return 0
  echo "bin/leaks: Betterleaks found secrets (above, redacted). Remove them, and revoke any that are real: git" \
    "history is public. One that isn't a secret gets \`betterleaks:allow\` in a comment on its line, or its" \
    "Fingerprint in .betterleaksignore with the reason." >&2
  return 1
}

# The pre-push hook's stdin has a line per ref: local ref, local commit, remote ref, remote commit. A commit of zeros
# is a ref that doesn't exist on that side.
check_push() {
  local remote=$1 local_ref local_commit remote_ref remote_commit range status=0
  while read -r local_ref local_commit remote_ref remote_commit; do
    [[ "$local_commit" =~ ^0+$ ]] && continue
    if [[ "$remote_commit" =~ ^0+$ ]] || ! git cat-file -e "$remote_commit^{commit}" 2>/dev/null; then
      range="$local_commit --not --remotes=$remote"
    else
      range="$remote_commit..$local_commit"
    fi
    git ls-tree -r --name-only "$local_commit" | check_names || status=1
    check_contents git --log-opts "$range" || status=1
  done
  return "$status"
}

status=0
case "${1:-}" in
  "")
    git ls-tree -r --name-only HEAD | check_names || status=1
    check_contents git --log-opts HEAD || status=1
    ;;
  --staged)
    (($# == 1)) || usage
    git diff --cached --name-only --diff-filter=d | check_names || status=1
    check_contents git --pre-commit --staged || status=1
    ;;
  --push)
    (($# == 2)) || usage
    check_push "$2" || status=1
    ;;
  --stdin)
    (($# == 2)) || usage
    printf '%s\n' "$2" | check_names || status=1
    check_contents stdin --set-attr "path=$2" || status=1
    ;;
  --install)
    (($# == 1)) || usage
    hooks=$(git config --get core.hooksPath)
    if [[ -n "$hooks" && "$hooks" != .githooks ]]; then
      echo "bin/leaks: git already runs the hooks in $hooks; add .githooks/pre-commit and pre-push there" >&2
    else
      git config core.hooksPath .githooks || status=1
    fi
    betterleaks version >/dev/null || status=1
    ;;
  *) usage ;;
esac

exit "$status"
